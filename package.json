{
  "name": "vanillatracker",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "VanillaTracker - ewidencja sprzętu i licencji (Astro + Cloudflare Workers + D1)",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev -c dist/server/wrangler.json",
    "deploy": "astro build && wrangler deploy -c dist/server/wrangler.json",
    "check": "astro check",
    "db:create": "wrangler d1 create vanillatracker",
    "db:migrate:local": "wrangler d1 migrations apply vanillatracker --local",
    "db:migrate:remote": "wrangler d1 migrations apply vanillatracker --remote"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.7",
    "@pdf-lib/fontkit": "^1.1.1",
    "astro": "^7.1.6",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260801.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.118.0"
  }
}
