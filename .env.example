# VanillaTracker — przykładowa konfiguracja środowiska
# Skopiuj ten plik jako .env i uzupełnij wartości.

# Klucz sesji Flask. Wygeneruj własny, np.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret

# Wymuś bezpieczne cookie sesji (true tylko gdy serwujesz przez HTTPS)
HTTPS_ONLY=false

# ── Serwer deweloperski (uruchamiany przez `python app.py`) ───────────────────
# FLASK_DEBUG=true tylko lokalnie — NIGDY na produkcji (interaktywna konsola
# Werkzeuga = zdalne wykonanie kodu). Na produkcji uruchamiaj przez WSGI.
FLASK_DEBUG=false
FLASK_HOST=0.0.0.0
FLASK_PORT=8000

# ── Baza danych ───────────────────────────────────────────────────────────────
# Wariant A: pełny URL połączenia (ma pierwszeństwo nad zmiennymi DB_*).
#   SQLite:  sqlite:///./db.sqlite3   (ścieżka względna od katalogu projektu)
#   MySQL:   mysql+pymysql://user:password@host:3306/vanillatracker
# DATABASE_URL=sqlite:///./db.sqlite3

# Wariant B: parametry MySQL (używane gdy DATABASE_URL nie jest ustawione,
# a DB_HOST tak). Jeśli żaden z wariantów nie jest ustawiony — używana jest
# lokalna baza SQLite (db.sqlite3).
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=vanillatracker
# DB_USER=root
# DB_PASSWORD=
