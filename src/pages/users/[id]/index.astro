---
/** Szczegóły osoby — port `user_detail.html` (bez pola login i zmiany hasła). */
import HistoryTimeline from '../../../components/HistoryTimeline.astro';
import StatusChip from '../../../components/StatusChip.astro';
import Field from '../../../components/Field.astro';
import Base from '../../../layouts/Base.astro';
import {
  ASSET_STATUS,
  assetName,
  fullName,
  initials,
  type AssetRow,
  type HistoryWithRefs,
  type LicenseRow,
  type UserRow,
} from '../../../lib/db';
import { categoryIcon } from '../../../lib/format';
import { parseId } from '../../../lib/forms';
import { tk } from '../../../lib/i18n';

const { t, db } = Astro.locals;

const id = parseId(Astro.params.id);
if (id === null) return Astro.redirect('/users/');

const [userResult, assetsResult, licensesResult, historyResult] = await db.batch([
  db
    .prepare(
      `SELECT u.*, d.name AS department_name
         FROM users u
         LEFT JOIN departments d ON d.id = u.department_id
        WHERE u.id = ?`,
    )
    .bind(id),
  db
    .prepare(
      `SELECT a.id, a.asset_tag, a.manufacturer, a.model_name,
              c.name AS category_name, c.slug AS category_slug
         FROM assets a
         LEFT JOIN categories c ON c.id = a.category_id
        WHERE a.assigned_to_id = ? AND a.status = ?
        ORDER BY a.tag_number`,
    )
    .bind(id, ASSET_STATUS.ASSIGNED),
  db
    .prepare(
      `SELECT l.id, l.asset_tag, l.name, l.status
         FROM licenses l
         JOIN license_users lu ON lu.license_id = l.id
        WHERE lu.user_id = ?
        ORDER BY l.tag_number`,
    )
    .bind(id),
  db
    .prepare(
      `SELECT h.*, a.asset_tag AS asset_tag, NULL AS license_tag,
              NULL AS user_first_name, NULL AS user_last_name
         FROM asset_history h
         LEFT JOIN assets a ON a.id = h.asset_id
        WHERE h.user_id = ?
        ORDER BY h.created_at DESC, h.id DESC
        LIMIT 20`,
    )
    .bind(id),
]);

type AssignedAsset = Pick<AssetRow, 'id' | 'asset_tag' | 'manufacturer' | 'model_name'> & {
  category_name: string | null;
  category_slug: string | null;
};

const user = (userResult.results as (UserRow & { department_name: string | null })[])[0];
if (!user) return Astro.redirect('/users/');

const assignedAssets = assetsResult.results as AssignedAsset[];
const licenses = licensesResult.results as Pick<LicenseRow, 'id' | 'asset_tag' | 'name' | 'status'>[];
const history = historyResult.results as HistoryWithRefs[];

const name = fullName(user);
const rowStyle =
  'display:flex;align-items:center;gap:12px;padding:10px 20px;border-bottom:1px solid var(--md-outline-variant);text-decoration:none;color:var(--md-on-surface)';
---

<Base title={name}>
  <Fragment slot="top-actions">
    <a href={`/users/${id}/protocol/`} class="btn btn-outlined btn-sm" target="_blank">
      <span class="material-icons-round">description</span>
      <span>{t.user_protocol}</span>
    </a>
    <a href={`/users/${id}/edit/`} class="btn btn-tonal btn-sm">
      <span class="material-icons-round">edit</span>
      <span>{t.user_edit}</span>
    </a>
    <a href={`/users/${id}/delete/`} class="btn btn-error btn-sm">
      <span class="material-icons-round">delete</span>
      <span>{t.btn_delete}</span>
    </a>
  </Fragment>

  <div slot="breadcrumb" class="breadcrumb">
    <a href="/users/">{t.nav_users}</a>
    <span class="sep material-icons-round">chevron_right</span>
    <span class="current">{name}</span>
  </div>

  <div class="detail-grid">
    <div style="display:flex;flex-direction:column;gap:20px">
      <div class="card">
        <div class="card-header">
          <span class="material-icons-round" style="color:var(--md-primary)">devices</span>
          <h2>{t.user_assets_title}</h2>
          <span class="asset-tag" style="font-size:12px">{assignedAssets.length}</span>
        </div>
        {
          assignedAssets.length > 0 ? (
            <div class="card-body" style="padding:0">
              {assignedAssets.map((a) => (
                <a href={`/assets/${a.id}/`} style={rowStyle}>
                  <span class="material-icons-round" style="font-size:18px;color:var(--md-primary)">
                    {categoryIcon(a.category_slug)}
                  </span>
                  <span class="asset-tag">{a.asset_tag}</span>
                  <span style="flex:1;font-size:14px">{assetName(a)}</span>
                  <span class="text-sm text-muted">
                    {a.category_slug ? tk(t, `cat_${a.category_slug}`, a.category_name ?? '') : ''}
                  </span>
                </a>
              ))}
            </div>
          ) : (
            <div class="empty-state" style="padding:30px">
              <span class="material-icons-round" style="font-size:36px">
                devices
              </span>
              <p>{t.user_no_assets}</p>
            </div>
          )
        }
      </div>

      {
        licenses.length > 0 && (
          <div class="card">
            <div class="card-header">
              <span class="material-icons-round" style="color:var(--md-primary)">
                key
              </span>
              <h2>{t.nav_licenses}</h2>
            </div>
            <div class="card-body" style="padding:0">
              {licenses.map((l) => (
                <a href={`/licenses/${l.id}/`} style={rowStyle}>
                  <span
                    class="asset-tag"
                    style="background:var(--md-tertiary-container);color:var(--md-on-tertiary-container)"
                  >
                    {l.asset_tag}
                  </span>
                  <span style="flex:1;font-size:14px">{l.name}</span>
                  <StatusChip status={l.status} />
                </a>
              ))}
            </div>
          </div>
        )
      }

      <div class="card">
        <div class="card-header">
          <span class="material-icons-round" style="color:var(--md-primary)">history</span>
          <h2>{t.lbl_history}</h2>
        </div>
        <div class="card-body">
          <HistoryTimeline items={history} showAsset />
        </div>
      </div>
    </div>

    <div style="display:flex;flex-direction:column;gap:16px">
      <div class="card">
        <div class="card-header">
          <span class="material-icons-round" style="color:var(--md-primary)">badge</span>
          <h2>{t.user_profile}</h2>
        </div>
        <div class="card-body">
          <div
            style="display:flex;flex-direction:column;align-items:center;gap:12px;margin-bottom:20px;padding-bottom:20px;border-bottom:1px solid var(--md-outline-variant)"
          >
            <div class="avatar avatar-lg">{initials(user)}</div>
            <div style="text-align:center">
              <div style="font-size:18px;font-weight:500;color:var(--md-on-surface)">{name}</div>
              {user.position && <div class="text-sm text-muted">{user.position}</div>}
            </div>
          </div>

          <Field label={t.user_email} value={user.email} />
          <Field label={t.user_dept} value={user.department_name} />
          <Field label={t.user_phone} value={user.phone} />
        </div>
      </div>
    </div>
  </div>
</Base>
