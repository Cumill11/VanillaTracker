---
/** Usuwanie licencji - port tras `GET/POST /licenses/<pk>/delete/`. */
import ConfirmDelete from '../../../../components/ConfirmDelete.astro';
import Base from '../../../../layouts/Base.astro';
import { deleteWithTagRelease, type LicenseRow } from '../../../../lib/db';
import { parseId } from '../../../../lib/forms';
import { fmt } from '../../../../lib/i18n';

const { t, session, db } = Astro.locals;

const id = parseId(Astro.params.id);
if (id === null) return Astro.redirect('/licenses/');

const license = await db
  .prepare('SELECT id, asset_tag, tag_number, name FROM licenses WHERE id = ?')
  .bind(id)
  .first<Pick<LicenseRow, 'id' | 'asset_tag' | 'tag_number' | 'name'>>();

if (!license) return Astro.redirect('/licenses/');

if (Astro.request.method === 'POST') {
  await deleteWithTagRelease(db, 'licenses', id, license.tag_number);
  session.addMessage(fmt(t.msg_license_deleted, { tag: license.asset_tag }));
  return Astro.redirect('/licenses/');
}
---

<Base title={t.btn_delete} pageTitle={t.delete_title}>
  <ConfirmDelete
    objectName={`${license.asset_tag} - ${license.name}`}
    cancelHref={`/licenses/${id}/`}
    action={`/licenses/${id}/delete/`}
  />
</Base>
