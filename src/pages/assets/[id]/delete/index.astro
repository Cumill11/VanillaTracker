---
/** Usuwanie sprzętu - port tras `GET/POST /assets/<pk>/delete/`. */
import ConfirmDelete from '../../../../components/ConfirmDelete.astro';
import Base from '../../../../layouts/Base.astro';
import { assetName, deleteWithTagRelease, type AssetRow } from '../../../../lib/db';
import { parseId } from '../../../../lib/forms';
import { fmt } from '../../../../lib/i18n';

const { t, session, db } = Astro.locals;

const id = parseId(Astro.params.id);
if (id === null) return Astro.redirect('/assets/');

const asset = await db
  .prepare('SELECT id, asset_tag, tag_number, manufacturer, model_name FROM assets WHERE id = ?')
  .bind(id)
  .first<Pick<AssetRow, 'id' | 'asset_tag' | 'tag_number' | 'manufacturer' | 'model_name'>>();

if (!asset) return Astro.redirect('/assets/');

if (Astro.request.method === 'POST') {
  await deleteWithTagRelease(db, 'assets', id, asset.tag_number);
  session.addMessage(fmt(t.msg_asset_deleted, { tag: asset.asset_tag }));
  return Astro.redirect('/assets/');
}
---

<Base title={t.btn_delete} pageTitle={t.delete_title}>
  <ConfirmDelete
    objectName={`${asset.asset_tag} - ${assetName(asset)}`}
    cancelHref={`/assets/${id}/`}
    action={`/assets/${id}/delete/`}
  />
</Base>
